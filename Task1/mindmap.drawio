        <mxCell id="Lqjv6FdfcQ--SYkThq7g-33" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 10px; text-align: left;&quot;&gt;Партнёрские API без ограничений позволяют&lt;/span&gt;&lt;br style=&quot;font-size: 10px; text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 10px; text-align: left;&quot;&gt;внешним пользователям изменять данные&lt;/span&gt;&lt;br style=&quot;font-size: 10px; text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 10px; text-align: left;&quot;&gt;чужих клиентов. Нет авторизационного контроля&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 10px; text-align: left;&quot;&gt;на уровне систем обработки данных&lt;/span&gt;" vertex="1">
